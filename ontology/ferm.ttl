@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix obo:       <http://purl.obolibrary.org/obo/> .
@prefix FERM:      <https://github.com/Deleuzy/fermentation-ontology-demo/FERM_> .

# A learning demo, not part of PREFER and not an OBO Foundry ontology.
# Wherever PREFER (release 2026-08-24) has a fitting term it is reused; FERM
# terms exist only for the three gaps listed in results/gap_report.md.
# FERM IRIs are placeholders under the GitHub repository URL and do not resolve.
# Every obo: IRI below was looked up in the EBI Ontology Lookup Service by
# scripts/verify_terms.py; the result is saved in ontology/external_terms.json.
# External terms are declared here as MIREOT style stubs (label plus the
# superclass they have in their source ontology), not imported in full.

<https://github.com/Deleuzy/fermentation-ontology-demo/ferm.ttl>
    a owl:Ontology ;
    owl:versionIRI <https://github.com/Deleuzy/fermentation-ontology-demo/releases/2026-11-13/ferm.ttl> ;
    owl:versionInfo "2026-11-13" ;
    dcterms:title "Fermentation run demo ontology (FERM)" ;
    dcterms:description "A small OWL ontology describing precision fermentation runs, aligned to BFO, built on PREFER (the precision fermentation ontology) and reusing IAO, RO, OBI, COB, CL, NCBITaxon, ChEBI and UO terms. Built as a learning demo with synthetic data." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "Bogdan Andone" .

#################################################################
# Annotation properties (IAO)
#################################################################

obo:IAO_0000115 a owl:AnnotationProperty ; rdfs:label "definition" .
obo:IAO_0000116 a owl:AnnotationProperty ; rdfs:label "editor note" .
obo:IAO_0000412 a owl:AnnotationProperty ; rdfs:label "imported from" .

#################################################################
# Upper level stubs (BFO)
#################################################################

obo:BFO_0000015 a owl:Class ; rdfs:label "process" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/bfo.owl> .
obo:BFO_0000040 a owl:Class ; rdfs:label "material entity" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/bfo.owl> .
obo:BFO_0000031 a owl:Class ; rdfs:label "generically dependent continuant" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/bfo.owl> .

# BFO keeps occurrents, independent continuants and generically dependent
# continuants apart. These three axioms are the part of that the reasoner needs.
obo:BFO_0000015 owl:disjointWith obo:BFO_0000040 , obo:BFO_0000031 .
obo:BFO_0000040 owl:disjointWith obo:BFO_0000031 .

#################################################################
# Object and data properties (RO, OBI, IAO, PREFER)
#################################################################

obo:BFO_0000051 a owl:ObjectProperty ; rdfs:label "has part" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/ro.owl> .

obo:RO_0000057 a owl:ObjectProperty ; rdfs:label "has participant" ;
    rdfs:domain obo:BFO_0000015 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/ro.owl> .

obo:OBI_0000299 a owl:ObjectProperty ; rdfs:label "has specified output" ;
    rdfs:subPropertyOf obo:RO_0000057 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/obi.owl> .

obo:IAO_0000136 a owl:ObjectProperty ; rdfs:label "is about" ;
    rdfs:domain obo:IAO_0000030 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/iao.owl> .

obo:IAO_0000039 a owl:ObjectProperty ; rdfs:label "has measurement unit label" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/iao.owl> .

obo:IAO_0000004 a owl:DatatypeProperty ; rdfs:label "has measurement value" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/iao.owl> .

obo:PREFER_8000004 a owl:ObjectProperty ; rdfs:label "has medium ingredient" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .

obo:PREFER_8000006 a owl:ObjectProperty ; rdfs:label "uses bioreactor" ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range obo:PREFER_0000014 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .

obo:PREFER_8000015 a owl:ObjectProperty ; rdfs:label "cultures cell" ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range obo:CL_0000000 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .

obo:PREFER_8000060 a owl:ObjectProperty ; rdfs:label "has measured process variable" ;
    rdfs:domain obo:PREFER_0000004 ;
    rdfs:range obo:PREFER_9000001 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .

FERM:0000101 a owl:ObjectProperty ;
    rdfs:label "has carbon source" ;
    rdfs:subPropertyOf obo:PREFER_8000004 ;
    rdfs:domain obo:PREFER_0000011 ;
    obo:IAO_0000115 "A relation between a fermentation medium and a chemical entity that is an ingredient of the medium and is intended as the main carbon and energy source for the organism." ;
    obo:IAO_0000116 "PREFER has has medium ingredient but no way to say which ingredient is the carbon source. A role based model (the chemical bears a carbon source role) would be cleaner." .

#################################################################
# Reused classes (stubs). Intermediate PREFER classes are collapsed.
#################################################################

obo:COB_0000082 a owl:Class ; rdfs:label "planned process" ;
    rdfs:subClassOf obo:BFO_0000015 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/cob.owl> .

obo:COB_0000022 a owl:Class ; rdfs:label "organism" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/cob.owl> .

obo:CL_0000000 a owl:Class ; rdfs:label "cell" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/cl.owl> .

obo:IAO_0000030 a owl:Class ; rdfs:label "information content entity" ;
    rdfs:subClassOf obo:BFO_0000031 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/iao.owl> .
obo:IAO_0000109 a owl:Class ; rdfs:label "measurement datum" ;
    rdfs:subClassOf obo:IAO_0000030 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/iao.owl> .
obo:IAO_0000032 a owl:Class ; rdfs:label "scalar measurement datum" ;
    rdfs:subClassOf obo:IAO_0000109 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/iao.owl> .

# PREFER processes and material entities
obo:PREFER_9000003 a owl:Class ; rdfs:label "precision fermentation process" ;
    rdfs:subClassOf obo:COB_0000082 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
# The three restrictions below are a subset of PREFER's own axioms on
# fermentation run (checked in the 2026-08-24 release file).
obo:PREFER_0000004 a owl:Class ; rdfs:label "fermentation run" ;
    rdfs:subClassOf obo:PREFER_9000003 ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:PREFER_8000006 ;
                      owl:someValuesFrom obo:PREFER_0000014 ] ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:PREFER_8000015 ;
                      owl:someValuesFrom obo:PREFER_0000012 ] ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:RO_0000057 ;
                      owl:someValuesFrom obo:PREFER_0000011 ] ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_0000011 a owl:Class ; rdfs:label "fermentation medium" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_0000012 a owl:Class ; rdfs:label "cell biocatalyst" ;
    rdfs:subClassOf obo:CL_0000000 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_0000014 a owl:Class ; rdfs:label "bioreactor" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .

# PREFER process variables (information content entities)
obo:PREFER_0000098 a owl:Class ; rdfs:label "precision fermentation process variable" ;
    rdfs:subClassOf obo:IAO_0000030 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_9000000 a owl:Class ; rdfs:label "precision fermentation setpoint process variable" ;
    rdfs:subClassOf obo:PREFER_0000098 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_9000001 a owl:Class ; rdfs:label "precision fermentation measured process variable" ;
    rdfs:subClassOf obo:PREFER_0000098 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_9000002 a owl:Class ; rdfs:label "precision fermentation calculated process variable" ;
    rdfs:subClassOf obo:PREFER_0000098 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_0000180 a owl:Class ; rdfs:label "operation mode setpoint process variable" ;
    rdfs:subClassOf obo:PREFER_9000000 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_0000181 a owl:Class ; rdfs:label "batch operation mode" ;
    rdfs:subClassOf obo:PREFER_0000180 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_0000182 a owl:Class ; rdfs:label "fed-batch operation mode" ;
    rdfs:subClassOf obo:PREFER_0000180 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_0000041 a owl:Class ; rdfs:label "temperature measured process variable" ;
    rdfs:subClassOf obo:PREFER_9000001 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_0000040 a owl:Class ; rdfs:label "pH measured process variable" ;
    rdfs:subClassOf obo:PREFER_9000001 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_0000036 a owl:Class ; rdfs:label "initial culture volume measured process variable" ;
    rdfs:subClassOf obo:PREFER_9000001 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .
obo:PREFER_0000091 a owl:Class ; rdfs:label "titer process metric" ;
    rdfs:subClassOf obo:PREFER_9000002 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/prefer.owl> .

# Organisms (NCBITaxon). The real taxonomy path is collapsed to organism.
obo:NCBITaxon_4932 a owl:Class ; rdfs:label "Saccharomyces cerevisiae" ;
    rdfs:subClassOf obo:COB_0000022 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/ncbitaxon.owl> .
obo:NCBITaxon_562 a owl:Class ; rdfs:label "Escherichia coli" ;
    rdfs:subClassOf obo:COB_0000022 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/ncbitaxon.owl> .
obo:NCBITaxon_460519 a owl:Class ; rdfs:label "Komagataella phaffii" ;
    rdfs:subClassOf obo:COB_0000022 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/ncbitaxon.owl> .
obo:NCBITaxon_1423 a owl:Class ; rdfs:label "Bacillus subtilis" ;
    rdfs:subClassOf obo:COB_0000022 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/ncbitaxon.owl> .
obo:NCBITaxon_51453 a owl:Class ; rdfs:label "Trichoderma reesei" ;
    rdfs:subClassOf obo:COB_0000022 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/ncbitaxon.owl> .

# Carbon sources (ChEBI). ChEBI classes are chemical entities, which BFO
# places under material entity.
obo:CHEBI_17234 a owl:Class ; rdfs:label "glucose" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/chebi.owl> .
obo:CHEBI_17754 a owl:Class ; rdfs:label "glycerol" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/chebi.owl> .
obo:CHEBI_17790 a owl:Class ; rdfs:label "methanol" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/chebi.owl> .
obo:CHEBI_17992 a owl:Class ; rdfs:label "sucrose" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/chebi.owl> .

# Units (UO). Used as individuals, the way OBI uses them with
# "has measurement unit label". PREFER itself uses w3id.org/uom IRIs.
obo:UO_0000027 a owl:NamedIndividual ; rdfs:label "degree Celsius" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/uo.owl> .
obo:UO_0000032 a owl:NamedIndividual ; rdfs:label "hour" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/uo.owl> .
obo:UO_0000175 a owl:NamedIndividual ; rdfs:label "gram per liter" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/uo.owl> .
obo:UO_0000196 a owl:NamedIndividual ; rdfs:label "pH" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/uo.owl> .
obo:UO_0000099 a owl:NamedIndividual ; rdfs:label "liter" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/uo.owl> .

#################################################################
# New FERM terms (only where PREFER had no fitting term)
#################################################################

FERM:0000005 a owl:Class ;
    rdfs:label "target product" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    obo:IAO_0000115 "A material entity that a fermentation run is planned to produce, for example a recombinant protein." ;
    obo:IAO_0000116 "PREFER issue 70 (bioprocess products classification) is open. Products should also point to Protein Ontology (PR) or ChEBI terms; not done here because those IRIs were not checked." .

FERM:0000013 a owl:Class ;
    rdfs:label "run duration datum" ;
    rdfs:subClassOf obo:IAO_0000032 ;
    obo:IAO_0000115 "A scalar measurement datum that gives the time from inoculation to harvest of a fermentation run." ;
    obo:IAO_0000116 "No PREFER process variable for total run duration was found. It could be a PREFER calculated process variable instead." .
