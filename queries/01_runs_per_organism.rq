# How many runs used each organism? Runs are PREFER fermentation runs that
# culture a cell biocatalyst; the organism is the strain's NCBITaxon class.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX ferm: <https://github.com/Deleuzy/fermentation-ontology-demo/FERM_>

SELECT ?taxon ?organism (COUNT(DISTINCT ?run) AS ?runs)
WHERE {
  ?run a obo:PREFER_0000004 ;
       obo:PREFER_8000015 ?strain .
  ?strain a obo:PREFER_0000012 , ?taxon .
  ?taxon rdfs:label ?organism .
  FILTER(STRSTARTS(STR(?taxon), "http://purl.obolibrary.org/obo/NCBITaxon_"))
}
GROUP BY ?taxon ?organism
ORDER BY DESC(?runs) ?organism
